[Unit]
Description=iPXE-PveController provisioning agent
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/bin/pve-agent.py

[Service]
Type=simple
# Optional overrides (PVE_CTRL, PVE_INTERVAL, ...); see pve-agent.conf.
EnvironmentFile=-/etc/pve-agent.conf
# The agent polls forever by default (every PVE_INTERVAL seconds, default 5)
# until the node is accepted, then keeps the configuration applied. Use
# `--once` (or PVE_ONCE=true) to run a single report instead.
ExecStart=/usr/bin/python3 /usr/local/bin/pve-agent.py
# The agent normally never exits (it polls forever). Restart it if it is killed
# or crashes; a clean exit (e.g. the node was rejected) stays stopped.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
