# Copy this file to `.env` and adjust the values.
# Run `python main.py key:generate` to create a strong APP_KEY.

APP_NAME="iPXE PVE Controller"
APP_ENV=production
APP_DEBUG=false

# Secret used to sign cookies/tokens. MUST be unique and secret.
APP_KEY=

# HTTP server
APP_HOST=127.0.0.1
APP_PORT=8000
# Public base URL of the controller (used in generated boot scripts / API URLs)
APP_URL=http://127.0.0.1:8000

# Session / security
SESSION_LIFETIME=120
SESSION_COOKIE=pve_ctrl_session
SESSION_SECURE=false
TRUSTED_PROXIES=

# Database (SQLite file, relative to project root)
DB_PATH=database/sql.db

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300

# PXE / Netboot defaults (can be overridden per node / in the panel)
PXE_NEXT_SERVER=127.0.0.1
PXE_BOOT_FILE=boot.ipxe

# Maximum size for uploaded boot files (vmlinuz/initrd/squashfs), in MB
BOOTFILE_MAX_MB=8192
